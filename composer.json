{
	"name": "awen-online/valt",
	"description": "Valt — token-gated music platform on Cardano. Open-source core.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6 || ^10.5"
	},
	"autoload-dev": {
		"psr-4": {
			"Valt\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"lint": "Valt\\Tests\\Lint::run",
		"test": "phpunit"
	},
	"config": {
		"optimize-autoloader": true
	}
}
